{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build/web",
        "installCommand": "flutter pub get",
        "buildCommand": "flutter build web --release --web-renderer canvaskit --base-href /"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}